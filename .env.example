# corpus-lens-mcp — configuration
#
# Copy to `.env` (git-ignored) and fill in:   cp .env.example .env && chmod 600 .env
# `npm run dev` and `npm start` load `.env` automatically. On the hosting server,
# prefer a root-owned file outside the app directory, injected by systemd:
#     EnvironmentFile=/etc/corpus-lens/env
#
# Every setting except the API key also has a command-line flag, which wins over
# the environment. Values with spaces need no quotes here.

# ── Secret ──────────────────────────────────────────────────────────────────
# Google AI Studio key for the embedding call (GEMINI_API_KEY is also accepted).
# Environment only — there is deliberately no flag, since flags show up in `ps`.
# Use a separate key per environment, restricted to the Generative Language API.
GOOGLE_API_KEY=

# ── Data (required) ─────────────────────────────────────────────────────────
# The bundle's cache/ folder: .corpus-vectors.json + .corpus-vectors.json.npy
# flag: --cache-dir
CORPUS_CACHE_DIR=/path/to/corpus-lens-bundle/cache

# The theme taxonomy file.
# flag: --themes
CORPUS_THEMES=/path/to/corpus-lens-bundle/themes/Theme Descriptions.txt

# The server's ONE write: a JSONL record of who asked and what it cost. The
# daily ceilings are restored from it on restart, so keep it across deploys.
# flag: --usage-log
CORPUS_USAGE_LOG=./data/usage.jsonl

# Optional. Bundle root (the folder holding MANIFEST.json). When set, startup
# checks cache/ and themes/ against the manifest's sha256 list and refuses to
# start on a mismatch. Adds well under a second.
# flag: --verify-bundle
#CORPUS_VERIFY_BUNDLE=/path/to/corpus-lens-bundle

# ── Transport ───────────────────────────────────────────────────────────────
# stdio = local Claude Code / Claude Desktop;  http = Streamable HTTP at /mcp
# flag: --transport          default: stdio
CORPUS_TRANSPORT=http

# Bind address. Keep loopback and put a TLS reverse proxy (Apache) in front.
# flags: --host / --port     defaults: 127.0.0.1 / 8765
#CORPUS_HOST=127.0.0.1
#CORPUS_PORT=8765

# Comma-separated Host: values to accept (DNS-rebinding protection). Apache's
# ProxyPass rewrites Host to the backend address, which the default accepts —
# set this only if the proxy preserves the public Host header.
# flag: --allowed-hosts      default: 127.0.0.1:<port>, localhost:<port>
#CORPUS_ALLOWED_HOSTS=lens.example.edu

# ── Authentication (http transport) ─────────────────────────────────────────
# Bearer tokens, one per person:  name:token,name:token
# The name is what the usage log records and what the per-caller ceiling
# counts; identity comes ONLY from the token, never from a request header.
# Tokens must be at least 32 characters:   openssl rand -hex 32
# Environment only — no flag. Clients send:  Authorization: Bearer <token>
CORPUS_API_TOKENS=

# Serve http with NO authentication. Only for a loopback-only development
# machine; without this, http refuses to start when no tokens are set.
# flag: --allow-anonymous    default: false
#CORPUS_ALLOW_ANONYMOUS=true

# The caller name for stdio, and for anonymous http.
# flag: --caller             default: shared
#CORPUS_MCP_CALLER=shared

# ── Ceilings (days are UTC days) ────────────────────────────────────────────
# Queries per caller per day, cached repeats included.
# flag: --per-caller-daily   default: 200
#CORPUS_PER_CALLER_DAILY=200

# Total dollars per day across all callers; at the ceiling every query is
# refused until UTC midnight.
# flag: --dollars-daily      default: 1.00
#CORPUS_DOLLARS_DAILY=1.00

# $ per 1M input tokens, used to cost each query in the usage log. 2.00 is the
# pipeline's conservative figure; check your Google billing page for the real
# rate (a lower rate means the dollar ceiling allows more queries).
# flag: --dollars-per-m-tokens   default: 2.00
#CORPUS_DOLLARS_PER_M_TOKENS=2.00

# ── Retrieval ───────────────────────────────────────────────────────────────
# Cosine similarity at or above which passages from DIFFERENT documents are
# treated as editions of one text and merged into a single hit (the tools'
# `distinct` option, on by default). Measured on this corpus: editions of a
# verse sit at a median of 0.995; neighbouring verses at 0.82. Raise toward
# 0.98 to keep heavily revised editions apart; lower to merge more.
# flag: --edition-similarity   default: 0.95
#CORPUS_EDITION_SIMILARITY=0.95

# ── Tests only ──────────────────────────────────────────────────────────────
# Not read by the server. Point at a bundle root to enable the real-index
# tests:   CORPUS_BUNDLE_DIR=/path/to/bundle npm test
#CORPUS_BUNDLE_DIR=/path/to/corpus-lens-bundle
